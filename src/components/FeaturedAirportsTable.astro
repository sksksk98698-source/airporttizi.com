const { class: className } = Astro.props;
---

<div class:list={["w-full my-6", className]}>
    <h3 class="text-lg md:text-xl font-bold text-black/90 dark:text-white/90 mb-3 flex items-center gap-2">
        <span>🏆</span>
        <span>2026 梯子猫精选机场横向评测速查表</span>
    </h3>
    <div class="overflow-x-auto rounded-xl border border-black/10 dark:border-white/10 bg-white dark:bg-black/20 shadow-xs">
        <table class="w-full text-left text-xs md:text-sm border-collapse">
            <thead>
                <tr class="bg-sky-50 dark:bg-sky-950/40 text-sky-900 dark:text-sky-300 border-b border-sky-100 dark:border-sky-900/50 font-bold whitespace-nowrap">
                    <th class="py-3 px-3.5">机场名称</th>
                    <th class="py-3 px-3.5">线路架构</th>
                    <th class="py-3 px-3.5 text-center">官网注册</th>
                    <th class="py-3 px-3.5">入门价格 (类型)</th>
                    <th class="py-3 px-3.5 text-center">优惠码</th>
                    <th class="py-3 px-3.5">核心特色</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-black/5 dark:divide-white/5">
                {featuredAirports.map((airport) => (
                    <tr class="hover:bg-sky-50/50 dark:hover:bg-white/5 transition">
                        <td class="py-3 px-3.5 font-bold whitespace-nowrap">
                            <a href={airport.url} target="_blank" rel="noopener noreferrer" class="text-sky-600 dark:text-sky-400 hover:underline">
                                {airport.name}
                            </a>
                        </td>
                        <td class="py-3 px-3.5 text-black/70 dark:text-white/70 whitespace-nowrap">
                            {airport.architecture}
                        </td>
                        <td class="py-3 px-3.5 text-center whitespace-nowrap">
                            <a href={airport.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 font-bold text-sky-600 dark:text-sky-400 hover:text-sky-700 dark:hover:text-sky-300 hover:underline">
                                <span>官网注册</span>
                                <span>↗</span>
                            </a>
                        </td>
                        <td class="py-3 px-3.5 text-black/80 dark:text-white/80 whitespace-nowrap">
                            {airport.price}
                        </td>
                        <td class="py-3 px-3.5 text-center whitespace-nowrap">
                            <span class="inline-block px-1.5 py-0.5 rounded bg-sky-500/10 text-sky-700 dark:text-sky-300 font-mono text-xs font-semibold border border-sky-500/20">
                                {airport.code}
                            </span>
                            {airport.discount && (
                                <span class="ml-1 text-xs text-black/60 dark:text-white/60">({airport.discount})</span>
                            )}
                        </td>
                        <td class="py-3 px-3.5 text-black/70 dark:text-white/70 min-w-[240px]">
                            {airport.feature}
                        </td>
                    </tr>
                ))}
            </tbody>
        </table>
    </div>
</div>
