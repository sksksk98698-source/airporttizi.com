---
import { getCollection } from "astro:content";
import { siteUrl } from "@utils/url-utils";
import { deployConfig, profileConfig, siteConfig } from "@/config";

interface Props {
	title?: string;
	description?: string;
	image?: string;
	setOGTypeArticle?: boolean;
	noindex?: boolean;
	customCanonical?: string;
	customSchema?: Record<string, any> | Record<string, any>[];
}

let {
	title,
	description = siteConfig.subtitle,
	image,
	setOGTypeArticle = false,
	noindex = false,
	customCanonical,
	customSchema,
} = Astro.props;

const HOME_SEO_TITLE =
	"2026高端稳定机场推荐与机场排行｜性价比机场评测、价格、线路与机场梯子指南 - AirportTizi";
const HOME_SEO_DESC =
	"梯子猫（AirportTizi.com）专注2026稳定高速SS/V2Ray/Trojan/Hysteria2机场梯子推荐与深度评测，提供高端IEPL专线机场梯子排行、价格套餐对比、4K流媒体与ChatGPT/Claude解锁支持，助您挑选最适合的科学上网服务。";

const BRAND_SUFFIX = " - 梯子猫 AirportTizi";
let pageTitle: string;
if (title) {
	const trimmedTitle = title.trim();
	if (
		trimmedTitle.endsWith(BRAND_SUFFIX) ||
		trimmedTitle.endsWith("- AirportTizi") ||
		trimmedTitle.endsWith("- 梯子猫")
	) {
		pageTitle = trimmedTitle;
	} else {
		pageTitle = `${trimmedTitle}${BRAND_SUFFIX}`;
	}
} else {
	pageTitle = HOME_SEO_TITLE;
}

// 严格保证 Canonical URL 使用正式主域名并保持规范的尾部斜杠
const baseSiteUrl = (deployConfig.siteUrl || "https://airporttizi.com").replace(
	/\/+$/,
	"",
);
const pathname = Astro.url.pathname.startsWith("/")
	? Astro.url.pathname
	: `/${Astro.url.pathname}`;
const cleanPath = pathname.endsWith("/") ? pathname : `${pathname}/`;
const canonicalUrl =
	customCanonical || `${baseSiteUrl}${cleanPath === "//" ? "/" : cleanPath}`;

const isHomePage = cleanPath === "/" || cleanPath === "";

const slug = Astro.url.pathname.split("/").filter(Boolean).pop();

interface PageData {
	published?: Date | string;
	updated?: Date | string;
	tags?: string[];
	description?: string;
	category?: string;
}

let pageData: PageData = {};
try {
	const allEntries = await getCollection("posts");
	const entry = allEntries.find((e) => e.id === slug);
	if (entry) {
		pageData = entry.data as PageData;
	}
} catch (e) {
	// silent fail if no blog/post page
}

let ogImage: string | undefined;

const defaultOgImage = siteConfig.ogImage.useDefault
	? siteUrl(siteConfig.ogImage.defaultSrc)
	: undefined;

ogImage = defaultOgImage;

if (image && typeof image === "string" && image.trim() !== "") {
	if (image.startsWith("http://") || image.startsWith("https://")) {
		ogImage = image;
	} else if (image.startsWith("/media") || image.startsWith("media")) {
		ogImage = siteUrl(image);
	} else {
		ogImage = defaultOgImage;
	}
}

const formatDate = (date: Date | string | undefined): string | null => {
	if (!date) {
		return null;
	}
	if (date instanceof Date) {
		return date.toISOString().split("T")[0];
	}
	if (typeof date === "string") {
		return date.split("T")[0];
	}
	return null;
};

const publishedDate = formatDate(pageData.published);
const updatedDate = formatDate(pageData.updated);

const tags: string[] = pageData.tags || [];

if (!description || description === siteConfig.subtitle) {
	description = pageData.description || HOME_SEO_DESC;
}

const defaultKeywords =
	"机场推荐,机场梯子,科学上网,2026机场推荐,梯子排行,机场测评,IPLC专线,IEPL专线,4K流媒体解锁,ChatGPT机场,Clash配置,Shadowrocket,科学上网梯子";
const pageKeywords =
	tags.length > 0 ? tags.join(", ") + ", " + defaultKeywords : defaultKeywords;

const robotsContent = noindex
	? "noindex, nofollow"
	: "index, follow, max-image-preview:large";

// 结构化数据 Schema 组装
const graphItems: Record<string, any>[] = [
	{
		"@type": "WebSite",
		"@id": `${baseSiteUrl}/#website`,
		url: `${baseSiteUrl}/`,
		name: "AirportTizi 梯子猫",
		description: HOME_SEO_DESC,
		inLanguage: "zh-CN",
	},
	{
		"@type": "Organization",
		"@id": `${baseSiteUrl}/#organization`,
		name: "梯子猫 (AirportTizi)",
		url: `${baseSiteUrl}/`,
		logo: `${baseSiteUrl}/favicon/favicon-light-192.svg`,
	},
];

if (setOGTypeArticle) {
	// 文章页 Schema: BlogPosting / Article + 面包屑
	graphItems.push({
		"@type": "BlogPosting",
		"@id": `${canonicalUrl}#article`,
		isPartOf: {
			"@type": "WebPage",
			"@id": canonicalUrl,
		},
		headline: pageTitle,
		description: description,
		image: ogImage || `${baseSiteUrl}/media/images/banner.jpg`,
		datePublished: publishedDate || undefined,
		dateModified: updatedDate || publishedDate || undefined,
		author: {
			"@type": "Person",
			name: profileConfig.name,
			url: `${baseSiteUrl}/`,
		},
		publisher: {
			"@id": `${baseSiteUrl}/#organization`,
		},
		mainEntityOfPage: {
			"@type": "WebPage",
			"@id": canonicalUrl,
		},
		inLanguage: "zh-CN",
	});

	graphItems.push({
		"@type": "BreadcrumbList",
		"@id": `${canonicalUrl}#breadcrumb`,
		itemListElement: [
			{
				"@type": "ListItem",
				position: 1,
				name: "首页",
				item: `${baseSiteUrl}/`,
			},
			{
				"@type": "ListItem",
				position: 2,
				name: pageData.category || "文章",
				item: pageData.category
					? `${baseSiteUrl}/archive/?category=${encodeURIComponent(pageData.category)}`
					: `${baseSiteUrl}/`,
			},
			{
				"@type": "ListItem",
				position: 3,
				name: title || pageTitle,
				item: canonicalUrl,
			},
		],
	});
} else if (!isHomePage) {
	// 非首页栏目页与专题页基础面包屑
	graphItems.push({
		"@type": "BreadcrumbList",
		"@id": `${canonicalUrl}#breadcrumb`,
		itemListElement: [
			{
				"@type": "ListItem",
				position: 1,
				name: "首页",
				item: `${baseSiteUrl}/`,
			},
			{
				"@type": "ListItem",
				position: 2,
				name: title || "专题页面",
				item: canonicalUrl,
			},
		],
	});
}

// 注入自定义 Schema
if (customSchema) {
	if (Array.isArray(customSchema)) {
		graphItems.push(...customSchema);
	} else {
		graphItems.push(customSchema);
	}
}

const structuredData = {
	"@context": "https://schema.org",
	"@graph": graphItems,
};
---

<title>{pageTitle}</title>
<meta name="title" content={pageTitle} />
<meta name="description" content={description} />
<meta name="keywords" content={pageKeywords} />
<meta name="author" content={profileConfig.name} />
<meta name="robots" content={robotsContent} />
<link rel="canonical" href={canonicalUrl} />

<!-- 搜索引擎站长平台安全验证代码预留（直接源码输出，无需客户端JS） -->
{siteConfig.verification?.google && <meta name="google-site-verification" content={siteConfig.verification.google} />}
{siteConfig.verification?.bing && <meta name="msvalidate.01" content={siteConfig.verification.bing} />}
{siteConfig.verification?.baidu && <meta name="baidu-site-verification" content={siteConfig.verification.baidu} />}
{siteConfig.verification?.shenma && <meta name="shenma-site-verification" content={siteConfig.verification.shenma} />}

<meta property="og:site_name" content="AirportTizi 梯子猫" />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
{ogImage && <meta property="og:image" content={ogImage} />}

{setOGTypeArticle ? (
  <>
    <meta property="og:type" content="article" />
    {tags.map((tag: string) => (
    <meta property="article:tag" content={tag} />
    ))}
    {publishedDate && <meta property="article:published_time" content={publishedDate} />}
    {updatedDate && <meta property="article:modified_time" content={updatedDate} />}
  </>
  ) : (
  <meta property="og:type" content="website" />
  )
}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
{ogImage && <meta name="twitter:image" content={ogImage} />}

<script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>