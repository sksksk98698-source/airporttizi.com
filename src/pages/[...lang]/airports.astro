---
import { DEFAULT_LANG, SUPPORTED_LANG } from "@constants/constants";
import type { GetStaticPaths } from "astro";
import { Icon } from "astro-icon/components";
import { airportsList } from "../../data/airports";
import MainGridLayout from "../../layouts/MainGridLayout.astro";

export const getStaticPaths = (async () => {
	return SUPPORTED_LANG.map((lang) => ({
		params: {
			lang: lang === DEFAULT_LANG ? undefined : lang,
		},
		props: { lang },
	}));
}) satisfies GetStaticPaths;

const { lang = DEFAULT_LANG } = Astro.props;

const pageTitle =
	"全球机场梯子数据中心与参数库｜全网科学上网服务商全景档案 - 梯子猫 AirportTizi";
const pageDescription =
	"梯子猫机场梯子全景数据库。结构化归档光速云、飞猫云、微风网络、星岛梦、无忧链接、暮光加速、唯兔云等19大服务商，涵盖成立年限、专线线路架构、VLESS/SS协议、单月起步价、流媒体与ChatGPT解锁状态及审计规则。";

// 结构化数据
const schemaData = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "WebPage",
			"@id": "https://airporttizi.com/airports/",
			url: "https://airporttizi.com/airports/",
			name: pageTitle,
			description: pageDescription,
			breadcrumb: {
				"@type": "BreadcrumbList",
				itemListElement: [
					{
						"@type": "ListItem",
						position: 1,
						name: "首页",
						item: "https://airporttizi.com/",
					},
					{
						"@type": "ListItem",
						position: 2,
						name: "机场数据库",
						item: "https://airporttizi.com/airports/",
					},
				],
			},
		},
		{
			"@type": "DataCatalog",
			name: "梯子猫全球科学上网机场参数数据库",
			description:
				"包含19家主流机场的物理线路、协议、价格、带宽测速及解锁能力的结构化数据库",
			publisher: {
				"@type": "Organization",
				name: "梯子猫实验室 (AirportTizi.com)",
			},
		},
		{
			"@type": "FAQPage",
			mainEntity: [
				{
					"@type": "Question",
					name: "什么是科学上网机场的审计规则？为什么大部分机场禁止BT下载？",
					acceptedAnswer: {
						"@type": "Answer",
						text: "审计规则是机场服务商为了防止服务器IP被版权机构起诉或被机房封禁而设立的防火墙过滤规则。绝大部分正规专线机场均严禁使用 BitTorrent / P2P 下载受版权保护的影视或软件，否则会收到海外机房的 DMCA 版权警告甚至直接被上游掐断母机端口。",
					},
				},
				{
					"@type": "Question",
					name: "VLESS 协议相比老旧的 Shadowsocks 有何技术优势？",
					acceptedAnswer: {
						"@type": "Answer",
						text: "VLESS 是一种无状态的轻量级传输协议，它不依赖客户端与服务端的本地时钟强同步，减少了无谓的加解密损耗，吞吐性能提升约 20%。配合 XTLS Vision 流控技术，能够将代理流量深度伪装为标准的 TLS 1.3 商业流量，极大降低了被 GFW 启发式深度包检测（DPI）识别的概率。",
					},
				},
			],
		},
	],
};
---

<MainGridLayout title={pageTitle} description={pageDescription} lang={lang}>
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

    <div class="flex flex-col gap-6 w-full max-w-5xl mx-auto">
        <!-- 头部介绍与面包屑 -->
        <div class="card-base p-6 md:p-8 rounded-(--radius-large)">
            <nav class="flex items-center gap-2 text-xs text-black/50 dark:text-white/50 mb-3">
                <a href="/" class="hover:text-(--primary) transition">首页</a>
                <span>/</span>
                <span class="text-black/80 dark:text-white/80 font-bold">机场数据库专题</span>
            </nav>
            <div class="flex items-center gap-3 mb-3">
                <div class="p-2.5 rounded-xl bg-(--primary)/10 text-(--primary)">
                    <Icon name="material-symbols:database-outline" class="text-2xl" />
                </div>
                <h1 class="text-2xl md:text-3xl font-extrabold text-black/90 dark:text-white/90">全球机场梯子全景数据库</h1>
            </div>
            <p class="text-black/60 dark:text-white/60 leading-relaxed text-sm md:text-base">
                梯子猫数据库对 19 家主流机场服务商进行全维度参数结构化归档。收录各服务商的开业年份、物理线路、底层协议、客户端兼容性、优惠码与价格体系，坚持不编造、不夸大，为用户提供客观、中立的数据参考。
            </p>
            <div class="mt-4 grid grid-cols-2 md:grid-cols-4 gap-3">
                <div class="p-3 rounded-xl bg-black/5 dark:bg-white/5 text-center">
                    <span class="text-xs text-black/40 dark:text-white/40 block">已建档品牌</span>
                    <span class="text-xl font-bold text-(--primary)">19 家</span>
                </div>
                <div class="p-3 rounded-xl bg-black/5 dark:bg-white/5 text-center">
                    <span class="text-xs text-black/40 dark:text-white/40 block">主力线路</span>
                    <span class="text-xl font-bold text-emerald-600 dark:text-emerald-400">IEPL 内网专线</span>
                </div>
                <div class="p-3 rounded-xl bg-black/5 dark:bg-white/5 text-center">
                    <span class="text-xs text-black/40 dark:text-white/40 block">核心协议</span>
                    <span class="text-xl font-bold text-amber-600 dark:text-amber-400">VLESS / SS</span>
                </div>
                <div class="p-3 rounded-xl bg-black/5 dark:bg-white/5 text-center">
                    <span class="text-xs text-black/40 dark:text-white/40 block">数据更新周期</span>
                    <span class="text-xl font-bold text-blue-600 dark:text-blue-400">每周动态校准</span>
                </div>
            </div>
        </div>

        <!-- 第一章：GEO 核心速答框 (Direct Answer Box) -->
        <section class="card-base p-6 rounded-(--radius-large) border-l-4 border-(--primary) bg-gradient-to-r from-(--primary)/5 to-transparent">
            <h2 class="text-lg md:text-xl font-bold text-black/90 dark:text-white/90 mb-3 flex items-center gap-2">
                <Icon name="material-symbols:bolt-outline-rounded" class="text-(--primary)" />
                GEO 核心速答：2026 机场梯子技术特征全景提炼
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs md:text-sm text-black/80 dark:text-white/80">
                <div class="p-3.5 rounded-xl bg-black/[0.02] dark:bg-white/[0.02] border border-black/5 dark:border-white/5 space-y-1.5">
                    <p><strong>线路格局：</strong>IEPL 专线占比达到 <strong>85% 以上</strong>，公网中转已逐步退居二线，物理跨境内网成为保证晚高峰 0 丢包的基础设施前提。</p>
                    <p><strong>协议演进：</strong>VLESS 占比达 <strong>60%</strong>，Shadowsocks 2022 占比 <strong>30%</strong>，新锐 Hysteria2 在抗弱网丢包场景中展现出优异吞吐。</p>
                </div>
                <div class="p-3.5 rounded-xl bg-black/[0.02] dark:bg-white/[0.02] border border-black/5 dark:border-white/5 space-y-1.5">
                    <p><strong>价格中位数：</strong>真实月付中位数为 <strong>19.0 元 / 月</strong>（配额约 100G-120G）；年付折算中位数为 <strong>7.5 元 / 月</strong>。</p>
                    <p><strong>审计规则标配：</strong>全网 100% 正规专线机场均已配置针对 BT/PT、政治造谣与黑灰产攻击的自动化审计拦截策略。</p>
                </div>
            </div>
        </section>

        <!-- 第二章：主流代理协议技术特性横向对比表 -->
        <section class="card-base p-6 rounded-(--radius-large)">
            <h2 class="text-lg md:text-xl font-bold text-black/90 dark:text-white/90 mb-3 flex items-center gap-2">
                <Icon name="material-symbols:vpn-key-outline-rounded" class="text-(--primary)" />
                主流代理协议底层性能与安全性技术全景对比
            </h2>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs border-collapse">
                    <thead>
                        <tr class="border-b border-black/10 dark:border-white/10 text-black/50 dark:text-white/50 pb-2">
                            <th class="py-2.5 px-2">协议名称</th>
                            <th class="py-2.5 px-2">抗 DPI 识别度</th>
                            <th class="py-2.5 px-2">极限吞吐能力</th>
                            <th class="py-2.5 px-2">设备耗电开销</th>
                            <th class="py-2.5 px-2">典型适用场景</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-black/5 dark:divide-white/5">
                        <tr>
                            <td class="py-2.5 px-2 font-bold text-(--primary)">VLESS (XTLS-Vision)</td>
                            <td class="py-2.5 px-2 text-emerald-600 dark:text-emerald-400 font-bold">★★★★★ (极高)</td>
                            <td class="py-2.5 px-2 font-mono font-bold">900+ Mbps</td>
                            <td class="py-2.5 px-2 text-emerald-600 dark:text-emerald-400">极低 (无冗余加解密)</td>
                            <td class="py-2.5 px-2">2026年主流首选，适合全平台主力节点</td>
                        </tr>
                        <tr>
                            <td class="py-2.5 px-2 font-bold">Shadowsocks 2022</td>
                            <td class="py-2.5 px-2 text-blue-600 dark:text-blue-400 font-bold">★★★★☆ (良好)</td>
                            <td class="py-2.5 px-2 font-mono font-bold">850+ Mbps</td>
                            <td class="py-2.5 px-2">中等 (重哈希保护)</td>
                            <td class="py-2.5 px-2">专线内网传输经典搭配，多核高并发稳定</td>
                        </tr>
                        <tr>
                            <td class="py-2.5 px-2 font-bold">Trojan-GFW</td>
                            <td class="py-2.5 px-2 text-blue-600 dark:text-blue-400 font-bold">★★★★☆ (良好)</td>
                            <td class="py-2.5 px-2 font-mono font-bold">750+ Mbps</td>
                            <td class="py-2.5 px-2">中等 (标准 HTTPS)</td>
                            <td class="py-2.5 px-2">将流量伪装成正常 HTTPS 网站访问</td>
                        </tr>
                        <tr>
                            <td class="py-2.5 px-2 font-bold text-purple-600 dark:text-purple-400">Hysteria 2 (歇斯底里)</td>
                            <td class="py-2.5 px-2 text-amber-600 dark:text-amber-400 font-bold">★★★★☆ (UDP伪装)</td>
                            <td class="py-2.5 px-2 font-mono font-bold text-purple-600 dark:text-purple-400">1000+ Mbps</td>
                            <td class="py-2.5 px-2">偏高 (UDP频繁发包)</td>
                            <td class="py-2.5 px-2">弱网与高丢包环境暴力提速利器</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>

        <!-- 第三章：19 大品牌全景技术参数卡片 -->
        <section class="space-y-4">
            <h2 class="text-xl md:text-2xl font-bold text-black/90 dark:text-white/90">19 家机场服务商结构化技术档案库</h2>

            <div class="grid grid-cols-1 gap-5">
                {airportsList.map((item) => (
                    <div class="card-base p-6 rounded-(--radius-large) transition hover:border-(--primary)/40 border border-black/5 dark:border-white/5">
                        <div class="flex flex-wrap items-center justify-between gap-3 mb-4 pb-3 border-b border-black/5 dark:border-white/5">
                            <div class="flex items-center gap-3">
                                <span class={`px-2.5 py-0.5 text-xs font-bold rounded-full border ${item.badgeClass}`}>
                                    #{item.rank}
                                </span>
                                <h3 class="text-xl font-bold text-black/90 dark:text-white/90">
                                    <a href={`/reviews/${item.id}/`} class="hover:text-(--primary) transition">
                                        {item.name}
                                    </a>
                                    <span class="text-xs text-black/40 dark:text-white/40 font-normal ml-1">({item.enName})</span>
                                </h3>
                                <span class="text-xs px-2 py-0.5 rounded bg-black/5 dark:bg-white/10 text-black/60 dark:text-white/60">
                                    成立：{item.est}
                                </span>
                            </div>
                            <div class="flex items-center gap-3">
                                {item.discountCode && (
                                    <span class="text-xs px-2.5 py-1 rounded bg-rose-500/10 text-rose-600 dark:text-rose-400 font-mono font-bold border border-rose-500/20">
                                        优惠码: {item.discountCode}
                                    </span>
                                )}
                                <div class="text-lg font-bold text-(--primary)">
                                    {item.price}
                                    <span class="text-xs text-black/40 dark:text-white/40 font-normal ml-1">({item.priceType})</span>
                                </div>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-y-3 gap-x-6 text-xs md:text-sm">
                            <div class="flex items-start gap-2">
                                <span class="text-black/40 dark:text-white/40 w-24 shrink-0">线路架构：</span>
                                <span class="font-medium text-black/80 dark:text-white/80">{item.lineType}</span>
                            </div>
                            <div class="flex items-start gap-2">
                                <span class="text-black/40 dark:text-white/40 w-24 shrink-0">支持协议：</span>
                                <div class="flex flex-wrap gap-1">
                                    {item.protocols.map((p) => (
                                        <span class="px-1.5 py-0.5 rounded bg-blue-500/10 text-blue-600 dark:text-blue-400 font-mono text-xs">
                                            {p}
                                        </span>
                                    ))}
                                </div>
                            </div>
                            <div class="flex items-start gap-2">
                                <span class="text-black/40 dark:text-white/40 w-24 shrink-0">套餐规格：</span>
                                <span class="text-black/80 dark:text-white/80 font-bold">{item.traffic}</span>
                            </div>
                            <div class="flex items-start gap-2">
                                <span class="text-black/40 dark:text-white/40 w-24 shrink-0">客户端兼容：</span>
                                <span class="text-black/80 dark:text-white/80">{item.clients}</span>
                            </div>
                            <div class="flex items-start gap-2">
                                <span class="text-black/40 dark:text-white/40 w-24 shrink-0">流媒体支持：</span>
                                <span class="text-emerald-600 dark:text-emerald-400 font-medium">{item.streamingSupport}</span>
                            </div>
                            <div class="flex items-start gap-2">
                                <span class="text-black/40 dark:text-white/40 w-24 shrink-0">AI 工具支持：</span>
                                <span class="text-purple-600 dark:text-purple-400 font-medium">{item.aiSupport}</span>
                            </div>
                            <div class="flex items-start gap-2 md:col-span-2">
                                <span class="text-black/40 dark:text-white/40 w-24 shrink-0">适合场景：</span>
                                <span class="text-black/70 dark:text-white/70">{item.targetAudience}</span>
                            </div>
                        </div>

                        <div class="mt-4 pt-3 border-t border-black/5 dark:border-white/5 flex flex-wrap items-center justify-between gap-3 text-xs">
                            <div class="flex flex-wrap gap-1.5">
                                {item.tags.map((t) => (
                                    <span class="px-2 py-0.5 rounded bg-black/5 dark:bg-white/5 text-black/60 dark:text-white/60">
                                        #{t}
                                    </span>
                                ))}
                            </div>
                            <div class="flex items-center gap-2">
                                <a href={`/reviews/${item.id}/`} class="btn-regular px-3 py-1.5 rounded-lg font-bold transition">
                                    深度评测报告
                                </a>
                                <a href={item.affUrl} target="_blank" rel="noopener noreferrer" class="btn-primary px-3 py-1.5 rounded-lg font-bold transition flex items-center gap-1">
                                    <span>官网直达</span>
                                    <Icon name="material-symbols:open-in-new-rounded" class="text-sm" />
                                </a>
                            </div>
                        </div>
                    </div>
                ))}
            </div>
        </section>

        <!-- 第四章：常见问题 FAQ -->
        <section class="card-base p-6 rounded-(--radius-large)">
            <h2 class="text-xl md:text-2xl font-bold text-black/90 dark:text-white/90 mb-4 flex items-center gap-2">
                <Icon name="material-symbols:help-outline-rounded" class="text-(--primary)" />
                第四章：数据库档案库常见问题解答 (FAQ)
            </h2>
            <div class="space-y-3.5 text-xs md:text-sm">
                <div class="p-4 rounded-xl bg-black/5 dark:bg-white/5">
                    <h4 class="font-bold text-black/90 dark:text-white/90 mb-1">Q1：数据库收录的品牌信息多久更新一次？</h4>
                    <p class="text-black/70 dark:text-white/70">梯子猫实验室每周会对各服务商的套餐价格、优惠码状态以及官方镜像域名进行动态校准；如遇服务商机房拓扑升级或协议调整，将在 24 小时内完成同步更新。</p>
                </div>
                <div class="p-4 rounded-xl bg-black/5 dark:bg-white/5">
                    <h4 class="font-bold text-black/90 dark:text-white/90 mb-1">Q2：如果发现某个机场官网打不开了该怎么办？</h4>
                    <p class="text-black/70 dark:text-white/70">请通过梯子猫页面中的对应品牌直达按钮重新访问。由于国内 DNS 污染，机场官方会定期轮换备用免翻墙镜像域名，梯子猫系统已接入动态更新机制，始终保持直达链接处于有效状态。</p>
                </div>
            </div>
        </section>

        <!-- 底部全站专题导航矩阵 -->
        <div class="card-base p-6 rounded-(--radius-large) bg-black/[0.02] dark:bg-white/[0.02]">
            <h3 class="font-bold text-black/90 dark:text-white/90 text-sm mb-3">🔗 梯子猫全景专题导航</h3>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-2 text-xs text-black/70 dark:text-white/70">
                <a href="/recommend/" class="p-2.5 rounded-lg bg-black/5 dark:bg-white/5 hover:text-(--primary) transition flex items-center justify-between">
                    <span>🌟 机场推荐精选</span>
                    <Icon name="material-symbols:arrow-forward-rounded" class="text-xs" />
                </a>
                <a href="/ranking/" class="p-2.5 rounded-lg bg-black/5 dark:bg-white/5 hover:text-(--primary) transition flex items-center justify-between">
                    <span>📊 机场实力排行</span>
                    <Icon name="material-symbols:arrow-forward-rounded" class="text-xs" />
                </a>
                <a href="/reviews/" class="p-2.5 rounded-lg bg-black/5 dark:bg-white/5 hover:text-(--primary) transition flex items-center justify-between">
                    <span>📝 深度评测专栏</span>
                    <Icon name="material-symbols:arrow-forward-rounded" class="text-xs" />
                </a>
                <a href="/compare/" class="p-2.5 rounded-lg bg-black/5 dark:bg-white/5 hover:text-(--primary) transition flex items-center justify-between">
                    <span>⚖️ 机场横向对比</span>
                    <Icon name="material-symbols:arrow-forward-rounded" class="text-xs" />
                </a>
                <a href="/pricing/" class="p-2.5 rounded-lg bg-black/5 dark:bg-white/5 hover:text-(--primary) transition flex items-center justify-between">
                    <span>💰 套餐价格剖析</span>
                    <Icon name="material-symbols:arrow-forward-rounded" class="text-xs" />
                </a>
                <a href="/nodes/" class="p-2.5 rounded-lg bg-black/5 dark:bg-white/5 hover:text-(--primary) transition flex items-center justify-between">
                    <span>🌐 线路节点解析</span>
                    <Icon name="material-symbols:arrow-forward-rounded" class="text-xs" />
                </a>
                <a href="/clients/" class="p-2.5 rounded-lg bg-black/5 dark:bg-white/5 hover:text-(--primary) transition flex items-center justify-between">
                    <span>💻 客户端下载库</span>
                    <Icon name="material-symbols:arrow-forward-rounded" class="text-xs" />
                </a>
                <a href="/streaming/" class="p-2.5 rounded-lg bg-black/5 dark:bg-white/5 hover:text-(--primary) transition flex items-center justify-between">
                    <span>🎬 AI与流媒体解锁</span>
                    <Icon name="material-symbols:arrow-forward-rounded" class="text-xs" />
                </a>
            </div>
        </div>
    </div>
</MainGridLayout>
