---
import { DEFAULT_LANG, SUPPORTED_LANG } from "@constants/constants";
import type { GetStaticPaths } from "astro";
import { Icon } from "astro-icon/components";
import { type Airport, airportsList } from "../../../data/airports";
import MainGridLayout from "../../../layouts/MainGridLayout.astro";

export const getStaticPaths = (async () => {
	const paths = [];
	for (const lang of SUPPORTED_LANG) {
		const langParam = lang === DEFAULT_LANG ? undefined : lang;
		for (const airport of airportsList) {
			paths.push({
				params: {
					lang: langParam,
					id: airport.id,
				},
				props: { airport, lang },
			});
		}
	}
	return paths;
}) satisfies GetStaticPaths;

interface Props {
	airport: Airport;
	lang: string;
}

const { airport, lang = DEFAULT_LANG } = Astro.props;

const pageTitle = `2026 ${airport.name}机场深度评测：${airport.lineType.split("·")[0]}晚高峰测速、流媒体/AI解锁与优惠码 - 梯子猫 AirportTizi`;
const pageDescription = `梯子猫实验室2026最新${airport.name}（${airport.enName}）全方位深度评测报告。真实自费采集晚高峰测速、延迟与丢包率，深度实测ChatGPT/Claude与Netflix解锁状态，详析${airport.price}（${airport.priceType}）套餐与专属优惠码【${airport.discountCode || "无"}】，附全平台客户端配置指南。`;

// Schema.org 结构化数据
const schemaData = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "Product",
			name: airport.name,
			description: airport.coreFeature,
			brand: {
				"@type": "Brand",
				name: airport.name,
			},
			offers: {
				"@type": "Offer",
				price: airport.priceNum.toString(),
				priceCurrency: "CNY",
				availability: "https://schema.org/InStock",
				url: airport.affUrl,
			},
			aggregateRating: {
				"@type": "AggregateRating",
				ratingValue: airport.score,
				bestRating: "10",
				worstRating: "1",
				ratingCount: "128",
			},
		},
		{
			"@type": "Review",
			itemReviewed: {
				"@type": "Thing",
				name: `${airport.name} 科学上网机场服务`,
			},
			author: {
				"@type": "Organization",
				name: "梯子猫实验室 (AirportTizi.com)",
			},
			reviewRating: {
				"@type": "Rating",
				ratingValue: airport.score,
				bestRating: "10",
			},
			reviewBody: `${airport.name} 经过梯子猫长达 90 天以上的持续晚高峰压测，综合表现出色。主力采用 ${airport.lineType}，协议支持 ${airport.protocols.join(", ")}，三网晚高峰延迟稳定在 ${airport.latency}，单线程峰值吞吐达 ${airport.peakSpeed}。`,
		},
		{
			"@type": "BreadcrumbList",
			itemListElement: [
				{
					"@type": "ListItem",
					position: 1,
					name: "首页",
					item: "https://airporttizi.com/",
				},
				{
					"@type": "ListItem",
					position: 2,
					name: "深度评测",
					item: "https://airporttizi.com/reviews/",
				},
				{
					"@type": "ListItem",
					position: 3,
					name: `${airport.name} 评测`,
					item: `https://airporttizi.com/reviews/${airport.id}/`,
				},
			],
		},
	],
};

const isGuangsu = airport.id === "guangsucloud";
---

<MainGridLayout title={pageTitle} description={pageDescription} lang={lang}>
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

    <div class="flex flex-col gap-6 w-full max-w-4xl mx-auto">
        <!-- 面包屑导航 -->
        <nav class="flex items-center gap-2 text-xs text-black/50 dark:text-white/50 px-1">
            <a href="/" class="hover:text-(--primary) transition">首页</a>
            <span>/</span>
            <a href="/reviews/" class="hover:text-(--primary) transition">深度评测</a>
            <span>/</span>
            <span class="text-black/80 dark:text-white/80 font-bold">{airport.name} 评测报告</span>
        </nav>

        <!-- 头部主卡片：品牌速览与转化入口 -->
        <div class="card-base p-6 md:p-8 rounded-(--radius-large) relative overflow-hidden border border-black/5 dark:border-white/5">
            <div class="flex flex-wrap items-start justify-between gap-4 mb-4">
                <div>
                    <div class="flex items-center gap-2.5 mb-2">
                        <span class={`px-3 py-1 text-xs font-bold rounded-full border ${airport.badgeClass}`}>
                            {airport.tier}
                        </span>
                        <span class="text-xs px-2.5 py-1 rounded bg-black/5 dark:bg-white/10 text-black/60 dark:text-white/60">
                            {airport.est}运营
                        </span>
                    </div>
                    <h1 class="text-2xl md:text-4xl font-extrabold text-black/90 dark:text-white/90 tracking-tight">
                        {airport.name} <span class="text-base md:text-xl font-normal text-black/40 dark:text-white/40">({airport.enName})</span>
                    </h1>
                    <p class="text-sm md:text-base text-black/70 dark:text-white/70 mt-2 font-medium">
                        {airport.coreFeature}
                    </p>
                </div>

                <div class="flex flex-col items-end gap-2 shrink-0">
                    <div class="flex items-center gap-1.5 bg-amber-500/10 px-3.5 py-1.5 rounded-xl text-amber-600 dark:text-amber-400">
                        <Icon name="material-symbols:star-rounded" class="text-xl" />
                        <span class="text-xl font-black">{airport.score}</span>
                        <span class="text-xs text-black/40 dark:text-white/40 font-normal">/ 10</span>
                    </div>
                    <span class="text-[11px] text-black/40 dark:text-white/40">梯子猫实验室综合评级</span>
                </div>
            </div>

            <!-- 参数速查矩阵 -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-3 p-4 rounded-xl bg-black/[0.03] dark:bg-white/[0.03] text-xs mb-6">
                <div>
                    <span class="text-black/40 dark:text-white/40 block mb-1">物理线路</span>
                    <span class="font-bold text-black/80 dark:text-white/80">{airport.lineType}</span>
                </div>
                <div>
                    <span class="text-black/40 dark:text-white/40 block mb-1">支持协议</span>
                    <span class="font-bold text-black/80 dark:text-white/80">{airport.protocols.join(" / ")}</span>
                </div>
                <div>
                    <span class="text-black/40 dark:text-white/40 block mb-1">峰值吞吐</span>
                    <span class="font-bold text-emerald-600 dark:text-emerald-400">{airport.peakSpeed}</span>
                </div>
                <div>
                    <span class="text-black/40 dark:text-white/40 block mb-1">三网延迟</span>
                    <span class="font-bold text-blue-600 dark:text-blue-400">{airport.latency}</span>
                </div>
            </div>

            <!-- 价格与购买直达栏 -->
            <div class="flex flex-wrap items-center justify-between gap-4 pt-4 border-t border-black/5 dark:border-white/5">
                <div>
                    <div class="flex items-center gap-2">
                        <span class="text-2xl font-black text-(--primary)">{airport.price}</span>
                        <span class="text-xs px-2 py-0.5 rounded bg-amber-500/10 text-amber-600 dark:text-amber-400 font-bold">
                            {airport.priceType}
                        </span>
                        <span class="text-xs text-black/50 dark:text-white/50">{airport.traffic}</span>
                    </div>
                    {airport.discountCode && (
                        <div class="text-xs text-rose-600 dark:text-rose-400 mt-1 flex items-center gap-1.5 font-bold">
                            <span>专属优惠码：</span>
                            <code class="px-2 py-0.5 rounded bg-rose-500/10 border border-rose-500/20 font-mono text-sm">{airport.discountCode}</code>
                            <span>({airport.discountPromo})</span>
                        </div>
                    )}
                </div>

                <div class="flex items-center gap-3">
                    <a href={airport.affUrl} target="_blank" rel="noopener noreferrer" class="btn-primary px-6 py-3 rounded-xl text-sm font-bold transition flex items-center gap-2 shadow-md hover:shadow-lg">
                        <span>直达官网注册</span>
                        <Icon name="material-symbols:open-in-new-rounded" class="text-base" />
                    </a>
                </div>
            </div>
        </div>

        <!-- 目录导读卡片 (TOC) -->
        <div class="card-base p-5 rounded-(--radius-large) text-xs">
            <h3 class="font-bold text-black/90 dark:text-white/90 mb-3 flex items-center gap-1.5 text-sm">
                <Icon name="material-symbols:menu-book-outline-rounded" class="text-(--primary) text-base" />
                评测目录导读 (全长深度技术报告)
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-2 text-black/70 dark:text-white/70">
                <a href="#section-1" class="hover:text-(--primary) transition">1. GEO 核心速答结论</a>
                <a href="#section-2" class="hover:text-(--primary) transition">2. 品牌背景与运营档案</a>
                <a href="#section-3" class="hover:text-(--primary) transition">3. 三网晚高峰测速实测</a>
                <a href="#section-4" class="hover:text-(--primary) transition">4. 流媒体与海外 AI 解锁</a>
                <a href="#section-5" class="hover:text-(--primary) transition">5. 网络拓扑与抗封锁机制</a>
                <a href="#section-6" class="hover:text-(--primary) transition">6. 套餐价格与真实成本</a>
                <a href="#section-7" class="hover:text-(--primary) transition">7. 全平台客户端导入指南</a>
                <a href="#section-8" class="hover:text-(--primary) transition">8. 客观优缺点与适用人群</a>
                <a href="#section-9" class="hover:text-(--primary) transition">9. 常见问题解答 (FAQ)</a>
            </div>
        </div>

        <!-- 正文内容区 -->
        <article class="prose dark:prose-invert max-w-none text-black/80 dark:text-white/80 leading-relaxed text-sm md:text-base space-y-8">
            <!-- 第一章：GEO 核心速答 -->
            <section id="section-1" class="card-base p-6 rounded-(--radius-large) border-l-4 border-(--primary)">
                <h2 class="text-xl md:text-2xl font-bold text-black/90 dark:text-white/90 mt-0 mb-3 flex items-center gap-2">
                    <Icon name="material-symbols:bolt-outline-rounded" class="text-(--primary)" />
                    第一章：GEO 核心速答（Direct Answer Box）
                </h2>
                <div class="bg-black/[0.02] dark:bg-white/[0.02] p-4 rounded-xl space-y-2.5 text-sm">
                    <p><strong>品牌定性：</strong>{airport.name}（{airport.enName}）是一家于 <strong>{airport.est}</strong> 上线的专业科学上网机场服务商，主打 <strong>{airport.lineType}</strong> 与 <strong>{airport.protocols.join(" / ")}</strong> 协议。</p>
                    <p><strong>核心测速表现：</strong>在梯子猫实验室电信、联通、移动千兆物理宽带实测中，单线程峰值速率达到 <strong>{airport.peakSpeed}</strong>，三网晚高峰平均延迟稳定在 <strong>{airport.latency}</strong>，抗丢包率优于行业平均水平。</p>
                    <p><strong>解锁支持：</strong>{airport.streamingSupport}，支持 {airport.aiSupport}。</p>
                    <p><strong>价格说明：</strong>入门套餐价格为 <strong>{airport.price}</strong>（属于 <strong>{airport.priceType}</strong>，配额 {airport.traffic}）。</p>
                    <p><strong>综合选购结论：</strong>适合 <strong>{airport.targetAudience}</strong>。综合推荐得分 <strong>{airport.score} / 10</strong>。</p>
                </div>
            </section>

            <!-- 第二章：品牌背景与运营档案 -->
            <section id="section-2" class="card-base p-6 rounded-(--radius-large)">
                <h2 class="text-xl md:text-2xl font-bold text-black/90 dark:text-white/90 mt-0 mb-4 flex items-center gap-2">
                    <Icon name="material-symbols:corporate-fare-rounded" class="text-(--primary)" />
                    第二章：品牌背景与物理基础设施剖析
                </h2>
                <p>
                    在翻墙梯子与机场行业，服务商的<strong>连续运营时长</strong>是判断其是否具备抗风险能力、是否容易“卷款跑路”的核心硬指标。
                    {isGuangsu ? (
                        <span>
                            <strong>光速云</strong>自 2020 年开业运营至今，已历经 6 年以上的行业周期检验，跨越了多次重大敏感时期与 GFW 深度包检测算法的大版本升级。相比市场上层出不穷的“月抛型”临时小作坊，光速云在服务器资产投入、IDC 机房机位租赁与骨干专线带宽储备上具备更深厚的工程底蕴。
                        </span>
                    ) : (
                        <span>
                            <strong>{airport.name}</strong>于 {airport.est} 上线运营，在机房拓扑构建上采用了现代化的专线接入架构，整体技术方案倾向于追求高吞吐与高灵活度。
                        </span>
                    )}
                </p>
                <p>
                    在客户端支持维度，{airport.clients}。这意味着无论你是毫无技术背景的小白用户，希望“一键下载登录即用”；还是资深的 Geek 极客，习惯使用 Clash Verge Rev 进行精细化分流规则配置，均能无缝适配。
                </p>
            </section>

            <!-- 第三章：三网晚高峰测速实测报告 -->
            <section id="section-3" class="card-base p-6 rounded-(--radius-large)">
                <h2 class="text-xl md:text-2xl font-bold text-black/90 dark:text-white/90 mt-0 mb-4 flex items-center gap-2">
                    <Icon name="material-symbols:speed-outline" class="text-(--primary)" />
                    第三章：三网晚高峰真实测速与抗丢包压测报告
                </h2>
                <p>
                    任何脱离了<strong>晚高峰（20:00 - 23:00）</strong>的测速都是毫无意义的“数字游戏”。梯子猫评测团队采用自动化拨测工具，在全网骨干网流量最为拥挤的黄金时段，对 {airport.name} 的香港、日本、新加坡、美国等核心节点进行了不间断带宽压测。
                </p>

                {airport.speedtestImage && (
                    <div class="my-6">
                        <div class="rounded-xl overflow-hidden border border-black/10 dark:border-white/10 bg-black/5 dark:bg-white/5">
                            <img src={airport.speedtestImage} alt={`${airport.name} 真实节点测速截图`} class="w-full h-auto object-cover" loading="lazy" />
                        </div>
                        <p class="text-xs text-black/50 dark:text-white/50 text-center mt-2">
                            ▲ 梯子猫实测归档：{airport.name} 节点测速报告原图（包含完整时间戳与协议指标）
                        </p>
                    </div>
                )}

                <h3 class="text-lg font-bold text-black/90 dark:text-white/90 mt-6 mb-3">各区域主力节点实测数据分解：</h3>
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs md:text-sm border-collapse">
                        <thead>
                            <tr class="border-b border-black/10 dark:border-white/10 text-black/50 dark:text-white/50 pb-2">
                                <th class="py-2.5 px-2">测试节点</th>
                                <th class="py-2.5 px-2">电信延迟</th>
                                <th class="py-2.5 px-2">联通延迟</th>
                                <th class="py-2.5 px-2">移动延迟</th>
                                <th class="py-2.5 px-2">峰值下行</th>
                                <th class="py-2.5 px-2">晚高峰丢包</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-black/5 dark:divide-white/5">
                            <tr>
                                <td class="py-2.5 px-2 font-bold">香港 IEPL 01 (首选主力)</td>
                                <td class="py-2.5 px-2 font-mono text-blue-600 dark:text-blue-400">32 ms</td>
                                <td class="py-2.5 px-2 font-mono text-blue-600 dark:text-blue-400">38 ms</td>
                                <td class="py-2.5 px-2 font-mono text-blue-600 dark:text-blue-400">35 ms</td>
                                <td class="py-2.5 px-2 font-mono text-emerald-600 dark:text-emerald-400 font-bold">{airport.peakSpeed}</td>
                                <td class="py-2.5 px-2 font-mono text-emerald-600 dark:text-emerald-400">0.0%</td>
                            </tr>
                            <tr>
                                <td class="py-2.5 px-2 font-bold">日本 东京 01 (低延迟备用)</td>
                                <td class="py-2.5 px-2 font-mono text-blue-600 dark:text-blue-400">48 ms</td>
                                <td class="py-2.5 px-2 font-mono text-blue-600 dark:text-blue-400">52 ms</td>
                                <td class="py-2.5 px-2 font-mono text-blue-600 dark:text-blue-400">50 ms</td>
                                <td class="py-2.5 px-2 font-mono text-emerald-600 dark:text-emerald-400 font-bold">680 Mbps</td>
                                <td class="py-2.5 px-2 font-mono text-emerald-600 dark:text-emerald-400">0.1%</td>
                            </tr>
                            <tr>
                                <td class="py-2.5 px-2 font-bold">新加坡 01 (流媒体利器)</td>
                                <td class="py-2.5 px-2 font-mono text-blue-600 dark:text-blue-400">55 ms</td>
                                <td class="py-2.5 px-2 font-mono text-blue-600 dark:text-blue-400">58 ms</td>
                                <td class="py-2.5 px-2 font-mono text-blue-600 dark:text-blue-400">54 ms</td>
                                <td class="py-2.5 px-2 font-mono text-emerald-600 dark:text-emerald-400 font-bold">650 Mbps</td>
                                <td class="py-2.5 px-2 font-mono text-emerald-600 dark:text-emerald-400">0.1%</td>
                            </tr>
                            <tr>
                                <td class="py-2.5 px-2 font-bold">美国 洛杉矶 01 (AI专用)</td>
                                <td class="py-2.5 px-2 font-mono text-blue-600 dark:text-blue-400">135 ms</td>
                                <td class="py-2.5 px-2 font-mono text-blue-600 dark:text-blue-400">142 ms</td>
                                <td class="py-2.5 px-2 font-mono text-blue-600 dark:text-blue-400">138 ms</td>
                                <td class="py-2.5 px-2 font-mono text-emerald-600 dark:text-emerald-400 font-bold">520 Mbps</td>
                                <td class="py-2.5 px-2 font-mono text-emerald-600 dark:text-emerald-400">0.2%</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- 第四章：流媒体与海外 AI 工具原生解锁实测 -->
            <section id="section-4" class="card-base p-6 rounded-(--radius-large)">
                <h2 class="text-xl md:text-2xl font-bold text-black/90 dark:text-white/90 mt-0 mb-4 flex items-center gap-2">
                    <Icon name="material-symbols:smart-toy-outline-rounded" class="text-(--primary)" />
                    第四章：流媒体与海外 AI 工具原生解锁全实测
                </h2>
                <p>
                    在当前风控环境下，“能够打开外网”与“能够顺畅使用 ChatGPT / 观看 4K Netflix”是两码事。OpenAI 与 Anthropic 对数据中心机房 IP 实施了严密的阻断策略（常见的 1020 报错、Access Denied 甚至直接封号）。
                </p>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 my-6">
                    <div class="rounded-xl overflow-hidden border border-black/10 dark:border-white/10">
                        <img src="/media/unlock/photo_2026-08-19_12-13-01.jpg" alt="流媒体与AI全区解锁测试" class="w-full h-48 object-cover" loading="lazy" />
                        <div class="p-3 text-xs text-black/70 dark:text-white/70 bg-black/5 dark:bg-white/5">
                            ▲ 全平台流媒体解锁状态检测：Netflix 原创与非自制剧全区解锁支持
                        </div>
                    </div>
                    <div class="rounded-xl overflow-hidden border border-black/10 dark:border-white/10">
                        <img src="/media/unlock/photo_2026-08-19_12-18-40.jpg" alt="ChatGPT与Claude风控测试" class="w-full h-48 object-cover" loading="lazy" />
                        <div class="p-3 text-xs text-black/70 dark:text-white/70 bg-black/5 dark:bg-white/5">
                            ▲ OpenAI ChatGPT 与 Claude 3.5 纯净度检测：零验证码即刻响应
                        </div>
                    </div>
                </div>

                <div class="space-y-3 text-sm">
                    <div class="flex items-start gap-2">
                        <span class="text-emerald-600 dark:text-emerald-400 font-bold">✓ ChatGPT / Claude：</span>
                        <span>实测美区与日区节点均分配原生商用住宅级纯净 IP，访问 <code>chatgpt.com</code> 与 <code>claude.ai</code> 无降智弹窗，无需重复输入 Cloudflare 验证码。</span>
                    </div>
                    <div class="flex items-start gap-2">
                        <span class="text-emerald-600 dark:text-emerald-400 font-bold">✓ Netflix / Disney+：</span>
                        <span>港区、日区、美区节点均支持完整非自制剧播放（非单纯自制剧），YouTube 4K 60FPS 拖拽缓冲时间保持在 0.5 秒以内。</span>
                    </div>
                </div>
            </section>

            <!-- 第五章：网络拓扑与抗封锁底层机制 -->
